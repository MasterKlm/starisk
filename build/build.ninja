build starisk.exe: CXX_EXECUTABLE_LINKER__starisk_Debug CMakeFiles/starisk.dir/include/imgui/backends/imgui_impl_glfw.cpp.obj CMakeFiles/starisk.dir/include/imgui/backends/imgui_impl_opengl3.cpp.obj CMakeFiles/starisk.dir/src/core/StarBatchManager.cpp.obj CMakeFiles/starisk.dir/src/core/StarQuad.cpp.obj CMakeFiles/starisk.dir/src/core/StarTexture.cpp.obj CMakeFiles/starisk.dir/src/core/StarTextureManager.cpp.obj CMakeFiles/starisk.dir/src/core/Starisk.cpp.obj CMakeFiles/starisk.dir/src/core/glad.c.obj CMakeFiles/starisk.dir/src/core/imgui/imgui.cpp.obj CMakeFiles/starisk.dir/src/core/imgui/imgui_draw.cpp.obj CMakeFiles/starisk.dir/src/core/imgui/imgui_tables.cpp.obj CMakeFiles/starisk.dir/src/core/imgui/imgui_widgets.cpp.obj CMakeFiles/starisk.dir/src/core/io/Joystick.cpp.obj CMakeFiles/starisk.dir/src/core/io/Keyboard.cpp.obj CMakeFiles/starisk.dir/src/core/io/Mouse.cpp.obj CMakeFiles/starisk.dir/src/core/shader.cpp.obj CMakeFiles/starisk.dir/src/core/stb_impl.cpp.obj CMakeFiles/starisk.dir/src/stariskEditor/StariskEditor.cpp.obj CMakeFiles/starisk.dir/src/stariskEditor/main.cpp.obj | C$:/starisk/lib/glfw3.lib
  CONFIG = Debug
  FLAGS = -O0 -g -Xclang -gcodeview -D_DEBUG -D_DLL -D_MT -Xclang --dependent-lib=msvcrtd
  LINK_FLAGS = -Xlinker /subsystem:console -fuse-ld=lld-link
  LINK_LIBRARIES = C:/starisk/lib/glfw3.lib  -lopengl32.lib  -lgdi32.lib  -luser32.lib  -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32 -loldnames
  OBJECT_DIR = CMakeFiles\starisk.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = CMakeFiles\starisk.dir\
  TARGET_FILE = starisk.exe
  TARGET_IMPLIB = starisk.lib
  TARGET_PDB = starisk.pdb
  TARGET_SUPPORT_DIR = CMakeFiles\starisk.dir


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\starisk\build && "C:\Program Files\CMake\bin\cmake-gui.exe" -SC:\starisk -BC:\starisk\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\starisk\build && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SC:\starisk -BC:\starisk\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build starisk: phony starisk.exe

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: C:/starisk/build

build all: phony starisk.exe

# =============================================================================
# Built-in targets


#############################################
# Re-run CMake if any of its inputs changed.

build build.ninja C$:/starisk/build/cmake_install.cmake: RERUN_CMAKE | C$:/Program$ Files/CMake/share/cmake-4.3/Modules/CMakeCInformation.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/CMakeCXXInformation.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/CMakeCommonLanguageInclude.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/CMakeGenericSystem.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/CMakeInitializeConfigs.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/CMakeLanguageInformation.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/CMakeRCInformation.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/CMakeSystemSpecificInformation.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/CMakeSystemSpecificInitialize.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Compiler/CMakeCommonCompilerMacros.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Compiler/Clang-C.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Compiler/Clang-CXX.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Compiler/Clang.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Internal/CMakeCLinkerInformation.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Internal/CMakeCXXLinkerInformation.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Internal/CMakeCommonLinkerInformation.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Linker/LLD-C.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Linker/LLD-CXX.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Linker/LLD.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Linker/MSVC.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Platform/Linker/Windows-LLD-C.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Platform/Linker/Windows-LLD-CXX.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Platform/Linker/Windows-LLD.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Platform/Linker/Windows-MSVC.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Platform/Windows-Clang-C.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Platform/Windows-Clang-CXX.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Platform/Windows-Clang.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Platform/Windows-Initialize.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Platform/Windows.cmake C$:/Program$ Files/CMake/share/cmake-4.3/Modules/Platform/WindowsPaths.cmake C$:/starisk/CMakeLists.txt CMakeCache.txt CMakeFiles/4.3.1/CMakeCCompiler.cmake CMakeFiles/4.3.1/CMakeCXXCompiler.cmake CMakeFiles/4.3.1/CMakeRCCompiler.cmake CMakeFiles/4.3.1/CMakeSystem.cmake
  pool = console


